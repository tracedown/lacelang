{
  "id": "custom_timeout_notification",
  "description": "A script-declared `timeout.notification` is emitted on timeout instead of the default config.timeout_message. Extension fields on call-config sub-objects live under `config.timeout.extensions` (lace-spec.md §9.2).",
  "spec_refs": [
    "lace-extensions.md §12"
  ],
  "type": "extension",
  "requires": [
    "extensions",
    "actions"
  ],
  "input": {
    "source": "get(\"http://127.0.0.1:{port}/slow\", { timeout: { ms: 100, action: \"fail\", notification: text(\"login timed out\") } }).expect(status: 200)\n",
    "variables": {},
    "extensions": [
      "laceNotifications"
    ],
    "http_mock": [
      {
        "callIndex": 0,
        "outcome": "timeout"
      }
    ]
  },
  "expected": {
    "result": {
      "outcome": "timeout",
      "startedAt": "1970-01-01T00:00:00Z",
      "endedAt": "1970-01-01T00:00:00Z",
      "runVars": {},
      "calls": "IGNORED",
      "actions": {
        "notifications": [
          {
            "callIndex": 0,
            "conditionIndex": -1,
            "trigger": "timeout",
            "notification": {
              "tag": "text",
              "value": "login timed out"
            }
          }
        ]
      }
    },
    "ignore": [
      "startedAt",
      "endedAt",
      "calls"
    ]
  }
}
