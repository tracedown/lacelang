{
  "id": "assert_silent_on_repeat_matches_condition_index",
  "description": "silentOnRepeat for an .assert() condition looks up the previous run's record by (method: assert, index) — not by position in assertions[], where scope records come first. Here the previous assert condition 0 failed, so the repeat is silenced even though assertions[0] is a passed status scope.",
  "spec_refs": [
    "lace-extensions.md §12"
  ],
  "type": "extension",
  "requires": [
    "extensions",
    "actions"
  ],
  "input": {
    "source": "get(\"http://127.0.0.1:{port}/fail\").expect(status: 503).assert({ check: [ this.status eq 200 ] })\n",
    "variables": {},
    "extensions": [
      "laceNotifications"
    ],
    "prev_results": {
      "outcome": "failure",
      "startedAt": "1970-01-01T00:00:00Z",
      "endedAt": "1970-01-01T00:00:00Z",
      "runVars": {},
      "calls": [
        {
          "index": 0,
          "outcome": "failure",
          "request": {
            "url": "http://127.0.0.1:9999/fail",
            "method": "get",
            "headers": {}
          },
          "response": {
            "status": 503,
            "headers": {},
            "responseTimeMs": 100
          },
          "redirects": [],
          "assertions": [
            {
              "method": "expect",
              "scope": "status",
              "op": "eq",
              "outcome": "passed",
              "actual": 503,
              "expected": 503,
              "options": null
            },
            {
              "method": "assert",
              "kind": "check",
              "index": 0,
              "outcome": "failed",
              "expression": "this.status eq 200",
              "actualLhs": 503,
              "actualRhs": 200,
              "options": null
            }
          ],
          "config": {},
          "warnings": [],
          "error": null
        }
      ],
      "actions": {
        "notifications": [
          {
            "callIndex": 0,
            "conditionIndex": 0,
            "trigger": "assert",
            "notification": {
              "tag": "structured",
              "data": {
                "kind": "check",
                "expression": "this.status eq 200",
                "actualLhs": 503,
                "actualRhs": 200
              }
            }
          }
        ]
      }
    },
    "http_mock": [
      {
        "callIndex": 0,
        "outcome": "response",
        "status": 503,
        "headers": {},
        "body": ""
      }
    ]
  },
  "expected": {
    "result": {
      "outcome": "success",
      "startedAt": "1970-01-01T00:00:00Z",
