{
  "id": "bare_map_notification_resolves",
  "description": "A bare object literal in a `notification` option is shorthand for op_map: the literal actual-value key wins first, so a 503 resolves to the \"503\" entry rather than \"default\".",
  "spec_refs": [
    "lace-extensions.md §12"
  ],
  "type": "extension",
  "requires": [
    "extensions",
    "actions"
  ],
  "input": {
    "source": "get(\"http://127.0.0.1:{port}/fail\").expect(status: { value: 200, options: { notification: { \"503\": text(\"unavailable\"), \"default\": text(\"other\") } } })\n",
    "variables": {},
    "extensions": [
      "laceNotifications"
    ],
    "http_mock": [
      {
        "callIndex": 0,
        "outcome": "response",
        "status": 503,
        "headers": {},
        "body": ""
      }
    ]
  },
  "expected": {
    "result": {
      "outcome": "failure",
      "startedAt": "1970-01-01T00:00:00Z",
      "endedAt": "1970-01-01T00:00:00Z",
      "runVars": {},
      "calls": "IGNORED",
      "actions": {
        "notifications": [
          {
            "callIndex": 0,
            "conditionIndex": -1,
            "trigger": "expect",
            "scope": "status",
            "notification": {
              "tag": "text",
              "value": "unavailable"
            }
          }
        ]
      }
    },
    "ignore": [
      "startedAt",
      "endedAt",
      "calls"
    ]
  }
}
