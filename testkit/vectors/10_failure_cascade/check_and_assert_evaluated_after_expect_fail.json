{
  "id": "check_and_assert_evaluated_after_expect_fail",
  "description": "A failed .expect() does not short-circuit the call's other assertion blocks: .check() scopes and .assert() conditions are still evaluated and recorded. The hard-fail cascade then skips .store()/.wait() and all subsequent calls (spec §4.1, §7).",
  "spec_refs": [
    "lace-spec.md §4.1",
    "lace-spec.md §7"
  ],
  "type": "execute",
  "input": {
    "source": "get(\"http://127.0.0.1:{port}/a\").expect(status: 200).check(totalDelayMs: 600000).assert({ check: [ this.status eq 500 ] }).store({ \"$$seen\": this.status })\nget(\"http://127.0.0.1:{port}/b\").expect(status: 200)\n",
    "variables": {},
    "http_mock": [
      {
        "callIndex": 0,
        "outcome": "response",
        "status": 500,
        "headers": {},
        "body": ""
      }
    ]
  },
  "expected": {
    "result": {
      "outcome": "failure",
      "startedAt": "1970-01-01T00:00:00Z",
      "endedAt": "1970-01-01T00:00:00Z",
      "runVars": {},
      "calls": [
        {
          "index": 0,
          "outcome": "failure",
          "startedAt": "1970-01-01T00:00:00Z",
          "endedAt": "1970-01-01T00:00:00Z",
          "request": "IGNORED",
          "response": "IGNORED",
          "redirects": [],
          "assertions": [
            {
              "method": "expect",
              "scope": "status",
              "op": "eq",
              "outcome": "failed",
              "actual": 500,
              "expected": 200,
              "options": null
            },
            {
              "method": "check",
              "scope": "totalDelayMs",
              "op": "lt",
              "outcome": "passed",
              "actual": "IGNORED",
              "expected": 600000,
              "options": null
            },
            {
              "method": "assert",
              "kind": "check",
              "index": 0,
              "outcome": "passed",
              "expression": "this.status eq 500",
              "actualLhs": 500,
              "actualRhs": 500,
              "options": null
            }
          ],
          "config": {},
          "warnings": [],
          "error": null
        },
        {
          "index": 1,
          "outcome": "skipped",
          "startedAt": null,
          "endedAt": null,
          "request": null,
          "response": null,
          "redirects": [],
          "assertions": [],
          "config": {},
          "warnings": [],
          "error": null
        }
      ],
      "actions": {}
    },
    "ignore": [
      "startedAt",
      "endedAt",
      "calls[0].startedAt",
      "calls[0].endedAt",
      "calls[0].request",
      "calls[0].response",
      "calls[*].config"
    ]
  }
}
